# Copy to .env for local overrides. Never commit real values (see .gitignore).

# --- database (compose defaults shown) ---
DATABASE_JDBC_URL=jdbc:postgresql://localhost:5432/lectern   # api (Spring)
DATABASE_URL=postgresql://lectern:lectern@localhost:5432/lectern  # worker (psycopg)
DATABASE_USERNAME=lectern
DATABASE_PASSWORD=lectern
REDIS_URL=redis://localhost:6379

# --- LLM (wk 2+; optional: the engine runs offline without it) ---
ANTHROPIC_API_KEY=

# --- object storage, Cloudflare R2 (wk 4+: uploads, exports, DB backups) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lectern

# --- auth (wk 4) ---
JWT_SECRET=

# --- cost controls (DESIGN §8) ---
LLM_HARD_CAP_USD=30
